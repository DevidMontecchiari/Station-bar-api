  "components": {
    "schemas": {
      "Error": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "Error"
      },
      "MenuItem": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "price": {
            "type": "number",
            "minimum": 0.0,
            "title": "Price"
          },
          "currency": {
            "type": "string",
            "const": "CHF",
            "title": "Currency"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "price",
          "currency",
          "available",
          "id"
        ],
        "title": "MenuItem"
      },
      "MenuItemInput": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "price": {
            "type": "number",
            "minimum": 0.0,
            "title": "Price"
          },
          "currency": {
            "type": "string",
            "const": "CHF",
            "title": "Currency"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "price",
          "currency",
          "available"
        ],
        "title": "MenuItemInput"
      },
      "Order": {
        "properties": {
          "table": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Table"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          },
          "id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "preparing",
              "ready",
              "served",
              "cancelled"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "table",
          "items",
          "id",
          "status"
        ],
        "title": "Order"
      },
      "OrderInput": {
        "properties": {
          "table": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Table"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "table",
          "items"
        ],
        "title": "OrderInput"
      },
      "OrderLine": {
        "properties": {
          "menu_item_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Menu Item Id"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "menu_item_id",
          "quantity"
        ],
        "title": "OrderLine"
      }
    }
  }
}
