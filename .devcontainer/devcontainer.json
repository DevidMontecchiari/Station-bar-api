{
  "name": "Station Bar API",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "codespace"
  },
  "remoteUser": "learner",
  "overrideCommand": true,
  "forwardPorts": [
    8000,
    8001,
    8002,
    8080,
    8081,
    8082
  ],
  "portsAttributes": {
    "8000": {
      "label": "JSON | Complete reference API",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "JSON | Exercise starter API",
      "onAutoForward": "notify"
    },
    "8002": {
      "label": "SQLite / ORM | Comparison API",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Frontend | Static prototype",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "Frontend | Browser fetch",
      "onAutoForward": "notify"
    },
    "8082": {
      "label": "Frontend | Jinja2",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "git.autofetch": true
      }
    }
  },
  "postAttachCommand": [
    "python",
    "${containerWorkspaceFolder}/.devcontainer/class_start.py"
  ]
}
