{
  "name": "Station Bar API",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "codespace"
  },
  "remoteUser": "learner",
  "overrideCommand": true,
  "forwardPorts": [
    8000,
    8001
  ],
  "portsAttributes": {
    "8000": {
      "label": "Complete reference API",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "Exercise starter API",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
