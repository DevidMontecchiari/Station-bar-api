{
  "name": "Station Bar API",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "codespace"
  },
  "remoteUser": "learner",
  "overrideCommand": true,
  "forwardPorts": [
    8000,
    8002,
    8080,
    8081,
    8082,
    8090
  ],
  "portsAttributes": {
    "8000": {
      "label": "API - JSON storage (/docs)",
      "onAutoForward": "silent"
    },
    "8001": {
      "label": "Earlier exercise - starter (/docs)",
      "onAutoForward": "silent"
    },
    "8002": {
      "label": "Recap - SQLite ORM (/docs)",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "1 - Static prototype (simulated)",
      "onAutoForward": "silent"
    },
    "8081": {
      "label": "2 - Browser + API (saved)",
      "onAutoForward": "silent"
    },
    "8082": {
      "label": "3 - Jinja pages (saved)",
      "onAutoForward": "silent"
    },
    "8090": {
      "label": "Styles - Custom CSS / Bootstrap",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "qwtel.sqlite-viewer"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "git.autofetch": true
      }
    }
  },
  "postAttachCommand": [
    "python",
    "${containerWorkspaceFolder}/.devcontainer/class_start.py"
  ]
}
